# Sentinel-Lite Environment Configuration
# Copy to .env and adjust for your local environment

# Environment: development / production / staging
ENVIRONMENT=development

# Database Configuration (PostgreSQL PostGIS)
DATABASE_URL=postgresql://sentinel:sentinel_password@localhost:5432/sentinel_db

# Real-Time Event & Messaging Layer (Redis)
# Local development: redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0
# AWS ElastiCache: redis://sentinel-redis.xxxxxx.0001.aps1.cache.amazonaws.com:6379/0
REDIS_URL=redis://localhost:6379/0

# Media Relay (MediaMTX)
RELAY_INTERNAL_URL=http://localhost:8888
RELAY_PUBLIC_URL=http://localhost:8888

# JWT Authentication Secret
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# Stream Ingestion Defaults
SENTINEL_INGEST_URL=http://localhost:8000/api/ingest
SENTINEL_API_KEY=
USE_LOCAL_FALLBACK=true
FALLBACK_VIDEO_PATH=traffic_sample.mp4
